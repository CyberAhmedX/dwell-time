{
  "name": "dwell-time",
  "version": "0.1.0",
  "private": true,
  "description": "A cozy-to-dark cybersecurity career simulation game.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
